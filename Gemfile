source 'https://rubygems.org'

# Specify your gem's dependencies in docker-compose.gemspec
gemspec

group :development do
  gem 'bundler', '~> 2.3'
  gem 'pry'
  gem 'pry-byebug'
  gem 'rake', '~> 13.0'
  gem 'rubocop'
  gem 'rubocop-rake'
  gem 'rubocop-rspec'
end

group :test do
  gem 'coveralls', require: false
  gem 'rspec'
end
